<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.airos.pos.app"
    android:versionCode="1"
    android:versionName="1.0.0-alpha01" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <queries>
        <package android:name="com.sunmi.innerprinter" />
        <package android:name="com.sunmi.innerprintadapter" />
        <package android:name="com.sunmi.printerservice" />
        <package android:name="com.sunmi.peripheral.printer" />
        <package android:name="com.sunmi.adapter.lcd" />
        <package android:name="com.sunmi.usbscreen" />
        <package android:name="com.sunmi.printer.firmware" />
        <package android:name="com.sunmi.scanner" />
        <package android:name="com.sunmi.sunmiqrcodescanner" />
        <package android:name="sunmi.unified.sdk.service" />
        <package android:name="sunmi_customer" />
        <package android:name="sunmi.service" />
        <package android:name="woyou.aidlservice.jiuiv5" />
    </queries>

    <!-- Network & hardware -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera permission (used for torch assist during scanning in low light) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- NFC — capability probe and future staff identification. required=false so the
         app installs on devices without NFC hardware (e.g. basic terminals). -->
    <uses-permission android:name="android.permission.NFC" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <permission
        android:name="com.airos.pos.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.airos.pos.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.airos.pos.app.AirosPosApplication"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirosPos"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.airos.pos.app.MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:theme="@style/Theme.AirosPos.Starting" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.airos.pos.app.WebRtcSmokeTestActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:label="AIROS POS WebRTC Smoke Test" />
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.airos.pos.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
