<resources>
    <style name="Theme.AirosPos" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/airos_splash_background</item>
        <item name="android:statusBarColor">@color/airos_splash_background</item>
        <item name="android:navigationBarColor">@color/airos_splash_background</item>
    </style>

    <style name="Theme.AirosPos.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/airos_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.AirosPos</item>
        <item name="android:statusBarColor">@color/airos_splash_background</item>
        <item name="android:navigationBarColor">@color/airos_splash_background</item>
    </style>
</resources>
