<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        DEV: sallitaan cleartext-yhteydet paikalliseen edge/gateway-osoitteeseen
        ja emulaattoriympäristöön.

        Tuotannossa tämä pitäisi rajata tiukemmaksi tai siirtää kokonaan TLS:n taakse.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator / localhost dev -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>

        <!-- Sunmi + LAN edge gateway -->
        <domain includeSubdomains="false">192.168.8.158</domain>
    </domain-config>
</network-security-config>